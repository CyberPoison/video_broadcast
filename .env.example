# ==============================================================================
# Headless Webpage Streamer Configuration
# Rename this file to .env and fill in the values below.
# ==============================================================================

# [REQUIRED] The URL of the webpage you want to capture and stream.
STREAM_URL=

# [OPTIONAL] Stream video parameters (defaults: 1280x720, 30 fps)
WIDTH=1280
HEIGHT=720
FPS=30

# ==============================================================================
# TELEGRAM STREAMING (Optional)
# Fill this section if you want to stream to Telegram Live Stream.
# Combine the Server URL and Stream Key from Telegram into a single RTMPS URL.
# Example: rtmps://dc5-1.rtmp.t.me/s/123456789:ABCDE12345...
# ==============================================================================
TELEGRAM_RTMP_URL=

# ==============================================================================
# DISCORD GO-LIVE STREAMING (Optional)
# Fill this section if you want to stream to a Discord voice channel.
# WARNING: Requires a DISCORD USER TOKEN. Do not use your primary account if
# you want to be extra safe.
# ==============================================================================
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
